# Persistent path on the Hostinger VPS. The systemd service account must be
# able to create and read files here; never serve this directory statically.
MEMBER_VIDEO_STORAGE_DIR=/var/lib/smh/member-course-videos

# Keep false until the Production migration, storage directory, permissions,
# and Nginx upload limit have been reviewed and approved.
SMH_MEMBER_VIDEOS_ENABLED=false

# Copy this file to /etc/smart-money-hub.env on the VPS.
# Fill credentials on the VPS only; never send them in chat or put them in a zip.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
GEMINI_API_KEY=

# Use the production IDs/settings from Replit when cutting over.
SMH_MAIN_CHANNEL_ID=
SMH_EDUCATION_GROUP_ID=
SMH_EDUCATION_MARKET_ANALYSIS_TOPIC_LINK=
SMH_DATABASE_PATH=/opt/smart-money-hub/data/smart_money_hub.sqlite3
SMH_REMINDER_TIMEZONE=Africa/Lagos
SMH_SUNDAY_REMINDER_TIME=09:00
SMH_DAILY_USD_GOLD_BRIEF_ENABLED=
SMH_WEEKLY_USD_GOLD_BRIEF_ENABLED=
LOG_LEVEL=INFO

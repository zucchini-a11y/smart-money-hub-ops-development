TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
ADMIN_TELEGRAM_ID=REPLACE_WITH_NUMERIC_USER_ID
PRO_SIGNALS_CHANNEL_ID=REPLACE_WITH_NEGATIVE_CHANNEL_ID
MARKET_ANALYSIS_CHANNEL_ID=REPLACE_WITH_DIFFERENT_NEGATIVE_CHANNEL_ID
# Telegram group destination ID. Keep the real value only in Replit Secrets.
EDUCATION_GROUP_ID=REPLACE_WITH_NEGATIVE_TELEGRAM_GROUP_ID
# Production keeps video lessons in a separate forum group.
SMH_EDUCATION_VIDEO_GROUP_ID=REPLACE_WITH_SEPARATE_NEGATIVE_GROUP_ID
SMH_EDUCATION_VIDEO_TOPIC_ID=REPLACE_WITH_VIDEO_TUTORIALS_TOPIC_ID
SMH_EDUCATION_VIDEO_TOPIC_NAME=Video tutorials
SMH_EDUCATION_VIDEO_STORAGE_DIR=./data/education-videos
# Optional onboarding resources; private forum message links include topic and message IDs.
EDUCATION_ANNOUNCEMENT_URL=
EDUCATION_EPISODE_01_URL=
EDUCATION_ONBOARDING_ENABLED=false
# "online" sends on the first worker run after the next Lagos calendar day begins; HH:MM is also accepted.
EDUCATION_DAY2_MODE=online
# Optional HTTPS education site URL; Telegram invite URLs are replaced with a per-member expiring invite.
SMH_EDUCATION_LINK=REPLACE_WITH_HTTPS_INVITE_OR_SITE_URL
EXNESS_PARTNER_LINK=REPLACE_WITH_OFFICIAL_EXNESS_PARTNER_URL
# Standard PostgreSQL URL. Obtain from any managed PostgreSQL provider.
SMH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SMH_DATA_DIR=./data
SMH_BACKUP_RETENTION=14
# Keep false during setup, migration, restore, and verification.
SMH_ALLOW_PUBLISHING=false

# Optional isolated private-channel test instance. Use a separate test bot,
# private test channels, and a disposable PostgreSQL database. Never production values.
SMH_ISOLATED_TEST_INSTANCE=false
SMH_TEST_TELEGRAM_BOT_TOKEN=REPLACE_WITH_DEDICATED_TEST_BOT_TOKEN
SMH_TEST_ADMIN_TELEGRAM_ID=REPLACE_WITH_NUMERIC_USER_ID
SMH_TEST_PRO_SIGNALS_CHANNEL_ID=REPLACE_WITH_PRIVATE_TEST_CHANNEL_ID
SMH_TEST_MARKET_ANALYSIS_CHANNEL_ID=REPLACE_WITH_DIFFERENT_PRIVATE_TEST_CHANNEL_ID
# Use a private test Education forum, never the production Education Group ID.
SMH_TEST_EDUCATION_GROUP_ID=REPLACE_WITH_PRIVATE_TEST_GROUP_ID
# The test Video tutorials topic may share the Education forum only when it is a different topic.
SMH_TEST_EDUCATION_VIDEO_GROUP_ID=REPLACE_WITH_SEPARATE_PRIVATE_TEST_GROUP_ID
SMH_TEST_EDUCATION_VIDEO_TOPIC_ID=REPLACE_WITH_TEST_TOPIC_ID
SMH_TEST_EDUCATION_VIDEO_TOPIC_NAME=Video tutorials
SMH_TEST_EDUCATION_VIDEO_STORAGE_DIR=./data-test/education-videos
SMH_TEST_EDUCATION_LINK=
SMH_TEST_EDUCATION_ANNOUNCEMENT_URL=
SMH_TEST_EDUCATION_EPISODE_01_URL=
SMH_TEST_EDUCATION_ONBOARDING_ENABLED=false
SMH_TEST_EDUCATION_DAY2_MODE=online
SMH_TEST_EXNESS_PARTNER_LINK=
SMH_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE?sslmode=require
SMH_TEST_DATA_DIR=./data-test
SMH_TEST_ALLOW_PUBLISHING=false
# Optional shared Replit Development Support Portal bridge for the Signal test bot only.
# Keep disabled unless this bot uses the smh_test schema and a dedicated test Telegram bot.
SMH_SUPPORT_API_ENABLED=false
SMH_SUPPORT_API_URL=http://127.0.0.1:8080
# Store the matching bearer token in the host's Secrets manager, never in this file.
SMH_SUPPORT_SIGNALS_TOKEN=

# Staff support portal. Serve the web app and /api on the same HTTPS origin.
# In production the API prefers SMH_DATABASE_URL, falling back to DATABASE_URL.
NODE_ENV=production
PORT=8080
